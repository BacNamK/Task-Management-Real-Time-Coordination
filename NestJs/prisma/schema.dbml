Enum EnumRoleSys {
  ADMIN
  MODER
  USER
}

Enum projectMemberRole {
  OWNER
  MODER
  MEMBER
}

Enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  MEMBER_JOINED
  MENTIONED
  SYSTEM
}

Enum ActionRequestType {
  PROJECT_INVITATION
  TASK_TRANSFER
  TASK_APPROVAL
  MEMBER_JOIN_REQUEST
}

Enum ActionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

Table user {
  id bigint [pk, increment]
  uuid text [unique, not null]
  name varchar [unique, not null]
  email varchar [unique, not null]
  avatar text
  created_at timestamp [not null, default: `now()`]
}

Table role {
  id int [pk, increment]
  role_name EnumRoleSys [not null]
  descrition text [not null]
}

Table role_user {
  id bigint [pk, increment]
  user_id bigint [unique, not null]
  role_id int [not null]
  indexes { role_id }
}

Table session {
  id bigint [pk, increment]
  user_id bigint [unique, not null]
  created_at timestamp [not null, default: `now()`]
  expired_at timestamp [not null]
  isBanned boolean [not null, default: false]
}

Table oauth_account {
  id text [pk]
  provider text [not null]
  providerAccountId text [not null]
  user_id bigint [not null]
  indexes {
    (provider, providerAccountId) [unique]
    user_id
  }
}

Table project {
  id bigint [pk, increment]
  uuid text [unique, not null]
  name varchar [not null]
  description text
  isDelete boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table permission {
  id int [pk, increment]
  name text [unique, not null]
  description text [not null]
}

Table project_member {
  id bigint [pk, increment]
  uuid text [unique, not null]
  project_id bigint [not null]
  user_id bigint [not null]
  role projectMemberRole [not null, default: 'MEMBER']
  permission_id int [not null]
  created_at timestamp [not null, default: `now()`]
  indexes {
    (project_id, user_id) [unique]
    permission_id
  }
}

Table board {
  id bigint [pk, increment]
  title varchar(255) [not null]
  project_id bigint [not null]
  description text
  isDelete boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  indexes { project_id }
}

Table cycle {
  id bigint [pk, increment]
  title varchar [not null]
  position int [not null, default: 0]
  status boolean [not null, default: true]
  columns json [not null]
  board_id bigint [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  indexes { (board_id, position) }
}

Table task {
  id bigint [pk, increment]
  title varchar [not null]
  position int [not null]
  description text
  isDelete boolean [not null, default: false]
  priority int [not null, default: 1]
  censor_id bigint
  created_at timestamp [not null, default: `now()`]
  due_date timestamp
  updated_at timestamp
  creator_id bigint [not null]
  cycle_id bigint
  board_id bigint [not null]
  indexes {
    (board_id, position)
    creator_id
    cycle_id
  }
}

Table tags {
  id text [pk]
  name varchar(255) [not null]
}

Table task_tag {
  task_id bigint [not null]
  tag_id text [not null]
  indexes {
    (task_id, tag_id) [pk]
    tag_id
  }
}

Table comments {
  id bigint [pk, increment]
  content text [not null]
  isDelete boolean [not null, default: false]
  task_id bigint [not null]
  send_by_id bigint [not null]
}

Table files {
  id text [pk]
  title text [not null]
  mime_type text [not null]
  size float [not null]
  storage_key text [unique, not null]
  bucket text [not null]
  provider text
  createdAt timestamp [not null, default: `now()`]
  send_by_id bigint [not null]
  project_id bigint [not null]
  task_id bigint [not null]
  indexes {
    send_by_id
    project_id
    task_id
  }
}

Table imageandvideo {
  id text [pk]
  mime_type text [not null]
  size float [not null]
  storage_key text [unique, not null]
  bucket text [not null]
  provider text
  message_id text [not null]
  send_by_id bigint [not null]
  project_id bigint [not null]
  indexes { project_id }
}

Table assigneeds {
  id bigint [pk, increment]
  task_id bigint [not null]
  user_id bigint [not null]
  indexes {
    (task_id, user_id) [unique]
    user_id
  }
}

Table chat_room {
  id bigint [pk, increment]
  uuid text [unique, not null]
  name varchar
  is_direct boolean [not null, default: false]
  project_id bigint [not null]
  indexes { project_id }
}

Table message {
  id text [pk]
  content text
  sender_id bigint [not null]
  room_id bigint [not null]
  replica_id bigint
  isDelete boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  reply_to_id text
  indexes {
    sender_id
    (room_id, created_at)
    reply_to_id
  }
}

Table chat_room_participant {
  id text [pk]
  chat_room_id bigint [not null]
  user_id bigint [not null]
  indexes {
    (chat_room_id, user_id) [unique]
    user_id
  }
}

Table notification {
  id text [pk]
  type NotificationType [not null]
  actor_id bigint [not null]
  title text [not null]
  message text
  entityType text
  entityId text
  metadata json
  createdAt timestamp [not null, default: `now()`]
}

Table receipt {
  id text [pk]
  notification_id text [not null]
  recipient_id bigint [not null]
  isRead boolean [not null, default: false]
  readAt timestamp
  indexes {
    (notification_id, recipient_id) [unique]
    (recipient_id, isRead, notification_id)
  }
}

Table actionrequest {
  id text [pk]
  type ActionRequestType [not null]
  status ActionRequestStatus [not null, default: 'PENDING']
  notification_id text
  sender_id bigint [not null]
  receipt_id text [not null]
  entityType text
  entityId text
  title text [not null]
  message text
  metadata json
  respondedAt timestamp
  expiresAt timestamp
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (receipt_id, status, createdAt)
    (sender_id, createdAt)
    (entityType, entityId)
  }
}

Ref: role_user.role_id > role.id [delete: cascade]
Ref: role_user.user_id > user.id [delete: cascade]
Ref: session.user_id > user.id
Ref: oauth_account.user_id > user.id [delete: cascade]
Ref: project_member.project_id > project.id [delete: cascade]
Ref: project_member.user_id > user.id [delete: cascade]
Ref: project_member.permission_id > permission.id [delete: restrict]
Ref: board.project_id > project.id [delete: cascade]
Ref: cycle.board_id > board.id [delete: cascade]
Ref: task.board_id > board.id [delete: cascade]
Ref: task.creator_id > user.id [delete: restrict]
Ref: task.cycle_id > cycle.id [delete: set null]
Ref: task.censor_id > user.id [delete: set null]
Ref: task_tag.task_id > task.id [delete: cascade]
Ref: task_tag.tag_id > tags.id [delete: cascade]
Ref: comments.task_id > task.id [delete: cascade]
Ref: comments.send_by_id > user.id [delete: cascade]
Ref: files.send_by_id > user.id [delete: cascade]
Ref: files.project_id > project.id [delete: cascade]
Ref: files.task_id > task.id [delete: cascade]
Ref: imageandvideo.send_by_id > user.id [delete: cascade]
Ref: imageandvideo.project_id > project.id [delete: cascade]
Ref: imageandvideo.message_id > message.id [delete: cascade]
Ref: assigneeds.task_id > task.id [delete: cascade]
Ref: assigneeds.user_id > user.id [delete: cascade]
Ref: chat_room.project_id > project.id [delete: cascade]
Ref: message.sender_id > user.id [delete: cascade]
Ref: message.room_id > chat_room.id [delete: cascade]
Ref: message.reply_to_id > message.id [delete: set null]
Ref: chat_room_participant.chat_room_id > chat_room.id [delete: cascade]
Ref: chat_room_participant.user_id > user.id [delete: cascade]
Ref: notification.actor_id > user.id [delete: cascade]
Ref: receipt.notification_id > notification.id [delete: cascade]
Ref: receipt.recipient_id > user.id [delete: cascade]
Ref: actionrequest.sender_id > user.id [delete: cascade]
Ref: actionrequest.receipt_id > receipt.id [delete: cascade]
