// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnumRoleSys {
  ADMIN
  MODER
  USER
}

enum projectMemberRole {
  OWNER
  MODER
  MEMBER
}

enum EnumStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id                   BigInt                @id @default(autoincrement())
  uuid                 String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Text
  name                 String                @unique @db.VarChar
  email                String                @unique @db.VarChar
  avatar               String?               @db.Text
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  roleUsers            RoleUserSys[]
  projectMembers       projectMember[]
  createdTasks         Task[]                @relation("CreatedTasks")
  assignedTasks        Assigneeds[]
  messages             Message[]
  chatRoomParticipants ChatRoomParticipant[]
  files                Files[]
  accounts             OAuthAccount[]
  session              Session[]
  task                 Task[]
  comments             Comments[]
  imageAndVideos       ImageAndVideo[]
  notification          Notification []
  actionrequest         ActionRequest[]

  @@map("user")
}

model RoleUserSys {
  id     BigInt @id @default(autoincrement())
  userId BigInt @unique @map("user_id")
  roleId Int    @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("role_user")
}

model Role {
  id          Int           @id @default(autoincrement())
  roleName    EnumRoleSys   @map("role_name")
  description String        @map("descrition") @db.Text
  roleUsers   RoleUserSys[]

  @@map("role")
}

model Session {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  expiredAt DateTime @db.Timestamp(6)
  isBanned  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@map("session")
}

model OAuthAccount {
  id                String @id @default(uuid())
  provider          String
  providerAccountId String
  userId            BigInt @map("user_id")
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_account")
}

model project {
  id             BigInt          @id @default(autoincrement())
  uuid           String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Text
  name           String          @db.VarChar
  description    String?         @db.Text
  isDelete       Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  members        projectMember[]
  boards         Board[]
  chatRooms      ChatRoom[]
  files          Files[]
  imageAndVideos ImageAndVideo[]

  @@map("project")
}

model projectMember {
  id           BigInt            @id @default(autoincrement())
  uuid         String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Text
  projectId    BigInt            @map("project_id")
  userId       BigInt            @map("user_id")
  role         projectMemberRole @default(MEMBER)
  permissionId Int               @map("permission_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  project      project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission        @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([permissionId])
  @@map("project_member")
}

model Permission {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.Text
  description String          @db.Text
  members     projectMember[]

  @@map("permission")
}

model Board {
  id          BigInt   @id @default(autoincrement())
  title       String   @db.VarChar(255)
  projectId   BigInt   @map("project_id")
  description String?  @db.Text
  isDelete    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  project     project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  cycles      Cycle[]

  @@index([projectId])
  @@map("board")
}

model Cycle {
  id        BigInt    @id @default(autoincrement())
  title     String    @db.VarChar
  position  Int       @default(0)
  status    Boolean   @default(true)
  columns   Json[]
  boardId   BigInt    @map("board_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId, position])
  @@map("cycle")
}

model Task {
  id          BigInt       @id @default(autoincrement())
  title       String       @db.VarChar
  position    Int
  description String?      @db.Text
  isDelete    Boolean      @default(false)
  priority    Int          @default(1)
  censorId    BigInt?      @map("censor_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  dueDate     DateTime?    @map("due_date") @db.Timestamp(6)
  updatedAt   DateTime?    @map("updated_at") @db.Timestamp(6)
  creatorId   BigInt       @map("creator_id")
  cycleId     BigInt?      @map("cycle_id")
  boardId     BigInt       @map("board_id")
  assigneeds  Assigneeds[]
  files       Files[]
  comments    Comments[]
  tags        TaskTag[]
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  creator     User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)
  cycle       Cycle?       @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [censorId], references: [id], onDelete: SetNull)

  @@index([boardId, position])
  @@index([creatorId])
  @@index([cycleId])
  @@map("task")
}

model Tags {
  id    String    @id @default(uuid())
  name  String    @db.VarChar(255)
  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId BigInt @map("task_id")
  tagId  String @map("tag_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tags   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tag")
}

model Comments {
  id       BigInt @id @default(autoincrement())
  content  String @db.Text
  isDelete Boolean @default(false)
  taskId   BigInt @map("task_id")
  sendById BigInt @map("send_by_id")
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [sendById], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Files {
  id         String   @id @default(uuid())
  title      String
  mimeType   String   @map("mime_type")
  size       Float
  storageKey String   @unique @map("storage_key")
  bucket     String
  provider   String?
  createdAt  DateTime @default(now()) @map("created_at")
  sendById   BigInt   @map("send_by_id")
  projectId  BigInt   @map("project_id")
  taskId     BigInt   @map("task_id")
  user       User     @relation(fields: [sendById], references: [id], onDelete: Cascade)
  project    project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sendById])
  @@index([projectId])
  @@index([taskId])
  @@map("files")
}

model ImageAndVideo {
  id         String  @id @default(uuid())
  mimeType   String  @map("mime_type")
  size       Float
  storageKey String  @unique @map("storage_key")
  bucket     String
  provider   String?
  messageId  String  @map("message_id")
  sendById   BigInt  @map("send_by_id")
  projectId  BigInt  @map("project_id")
  user       User    @relation(fields: [sendById], references: [id], onDelete: Cascade)
  project    project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("imageandvideo")
}

model Assigneeds {
  id     BigInt @id @default(autoincrement())
  taskId BigInt @map("task_id")
  userId BigInt @map("user_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("assigneeds")
}

model ChatRoom {
  id           BigInt                @id @default(autoincrement())
  uuid         String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Text
  name         String?               @db.VarChar
  isDirect     Boolean               @default(false) @map("is_direct")
  projectId    BigInt                @map("project_id")
  project      project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ChatRoomParticipant[]

  @@index([projectId])
  @@map("chat_room")
}

model Message {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Text
  content       String?         @db.Text
  senderId      BigInt          @map("sender_id")
  roomId        BigInt          @map("room_id")
  replicaId     BigInt?         @map("replica_id")
  isDelete      Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?       @map("updated_at") @db.Timestamp(6)
  sender        User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  room          ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replyToId     String?         @map("reply_to_id") @db.Text
  replyTo       Message?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]       @relation("MessageReplies")
  imageandvideo ImageAndVideo[]

  @@index([senderId])
  @@index([roomId, createdAt])
  @@index([replyToId])
  @@map("message")
}

model ChatRoomParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Text
  chatRoomId BigInt   @map("chat_room_id")
  userId     BigInt   @map("user_id")
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_room_participant")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  MEMBER_JOINED
  MENTIONED
  SYSTEM
}

model Notification {
  id   String           @id @default(uuid())
  type NotificationType

  actorId BigInt       @map("actor_id")
  title   String
  message String?

  entityType String?
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())

  user       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  receipts NotificationReceipt[]

  @@map("notification")
}

model NotificationReceipt {
  id String @id @default(uuid())

  notificationId String @map("notification_id")
  recipientId    String @map("recipient_id")

  isRead Boolean   @default(false)
  readAt DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientId])
  @@index([recipientId, isRead, notificationId])
  @@map("receipt")
}

enum ActionRequestType {
  WORKSPACE_INVITATION
  PROJECT_INVITATION
  TASK_TRANSFER
  TASK_APPROVAL
  MEMBER_JOIN_REQUEST
}

enum ActionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model ActionRequest {
  id String @id @default(uuid())

  type   ActionRequestType
  status ActionRequestStatus @default(PENDING)

  senderId    BigInt      @map("sender_id")
  recipientId String

  // Đối tượng nghiệp vụ liên quan
  entityType String?
  entityId   String?

  title    String
  message  String?
  metadata Json?

  respondedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, createdAt])
  @@index([senderId, createdAt])
  @@index([entityType, entityId])
  @@map("actionrequest")
}
